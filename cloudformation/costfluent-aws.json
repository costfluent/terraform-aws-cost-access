{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Grants Costfluent read-only access to this account's cost data and, in a management account, creates the FOCUS 1.2 and carbon emissions Data Exports Costfluent reads, in a bucket the stack creates or one you already have. Costfluent issues every parameter; open it from the Costfluent console.",
  "Metadata": {
    "AWS::CloudFormation::Interface": {
      "ParameterGroups": [
        {
          "Label": {
            "default": "Costfluent (filled in by Costfluent, do not change)"
          },
          "Parameters": [
            "CostfluentPrincipalArn",
            "ExternalId",
            "HandshakeId",
            "PingbackTopicArn"
          ]
        },
        {
          "Label": {
            "default": "Cost export"
          },
          "Parameters": [
            "CreateCostExport",
            "BucketName",
            "ExportName",
            "CreateCarbonExport"
          ]
        },
        {
          "Label": {
            "default": "A bucket or export you already have"
          },
          "Parameters": [
            "BucketExists",
            "BucketRegion",
            "ExportPrefix",
            "ExportExists"
          ]
        }
      ]
    }
  },
  "Parameters": {
    "CostfluentPrincipalArn": {
      "Type": "String",
      "Description": "The Costfluent role this account's role trusts.",
      "AllowedPattern": "^arn:aws[a-z-]*:iam::[0-9]{12}:role/.+$"
    },
    "ExternalId": {
      "Type": "String",
      "Description": "Your Costfluent organization's external ID.",
      "AllowedPattern": "^cf-[0-9a-f]{32}$",
      "NoEcho": true
    },
    "HandshakeId": {
      "Type": "String",
      "Description": "Ties this stack to the connection you started in Costfluent."
    },
    "PingbackTopicArn": {
      "Type": "String",
      "Description": "Where the stack tells Costfluent the role is ready.",
      "AllowedPattern": "^arn:aws[a-z-]*:sns:us-east-1:[0-9]{12}:.+$"
    },
    "CreateCostExport": {
      "Type": "String",
      "Description": "true creates the bucket and a daily FOCUS 1.2 Data Export, which in a member account holds only that account's cost; false connects through Cost Explorer only, for example where a service control policy blocks Data Exports.",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Default": "true"
    },
    "BucketName": {
      "Type": "String",
      "Description": "The bucket to create for the export or, when BucketExists is true, the bucket you already have. Ignored when CreateCostExport is false.",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "ExportName": {
      "Type": "String",
      "Description": "The name of the Data Export.",
      "Default": "costfluent-focus",
      "AllowedPattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "CreateCarbonExport": {
      "Type": "String",
      "Description": "true to also export the account's carbon emissions, which needs sustainability:GetCarbonFootprintSummary; false to connect cost without them; set false if the stack fails on CarbonExport.",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Default": "true"
    },
    "BucketExists": {
      "Type": "String",
      "Description": "true delivers the exports to the bucket you already have in this account, named in BucketName and in BucketRegion, instead of creating one. The stack does not change that bucket's policy: for a new export it must already let AWS Data Exports deliver, as the Costfluent docs show.",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Default": "false"
    },
    "BucketRegion": {
      "Type": "String",
      "Description": "The region of the bucket you already have. A bucket the stack creates is in us-east-1.",
      "Default": "us-east-1",
      "AllowedPattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$"
    },
    "ExportPrefix": {
      "Type": "String",
      "Description": "The folder the exports are delivered under, and the only one Costfluent may read files in: Costfluent reads s3://<BucketName>/<ExportPrefix>/<ExportName>/. Letters, digits, '-', '_', '.' and '/', with no '..'.",
      "Default": "costfluent",
      "AllowedPattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
    },
    "ExportExists": {
      "Type": "String",
      "Description": "true reads a Data Export you already deliver to s3://<BucketName>/<ExportPrefix>/<ExportName>/ instead of creating one, and needs BucketExists true. It must be FOCUS 1.2 with AWS columns, every column, daily.",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Default": "false"
    }
  },
  "Rules": {
    "UsEast1Only": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "us-east-1"
            ]
          },
          "AssertDescription": "Create this stack in us-east-1: AWS Data Exports and the Costfluent pingback run there."
        }
      ]
    },
    "ExistingExportNeedsExistingBucket": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "ExportExists"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "BucketExists"
              },
              "true"
            ]
          },
          "AssertDescription": "An export you already have is read from a bucket you already have: set BucketExists to true too."
        }
      ]
    },
    "CreatedBucketInUsEast1": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "BucketExists"
          },
          "false"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "BucketRegion"
              },
              "us-east-1"
            ]
          },
          "AssertDescription": "The stack creates its bucket in us-east-1: leave BucketRegion at us-east-1, or set BucketExists to true for a bucket you already have elsewhere."
        }
      ]
    }
  },
  "Conditions": {
    "CreateExport": {
      "Fn::Equals": [
        {
          "Ref": "CreateCostExport"
        },
        "true"
      ]
    },
    "CreateCarbon": {
      "Fn::And": [
        {
          "Condition": "CreateExport"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "CreateCarbonExport"
            },
            "true"
          ]
        }
      ]
    },
    "CreateBucket": {
      "Fn::And": [
        {
          "Condition": "CreateExport"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "BucketExists"
            },
            "false"
          ]
        }
      ]
    },
    "CreateFocusExport": {
      "Fn::And": [
        {
          "Condition": "CreateExport"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "ExportExists"
            },
            "false"
          ]
        }
      ]
    }
  },
  "Resources": {
    "CostfluentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "Read-only cost access for Costfluent.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CostfluentAssumeRole",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "CostfluentPrincipalArn"
                }
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CostfluentCostRead",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "CostExplorerReadOnly",
                  "Effect": "Allow",
                  "Action": [
                    "ce:GetCostAndUsage"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "CostExplorerCommitmentsReadOnly",
                  "Effect": "Allow",
                  "Action": [
                    "ce:GetReservationUtilization",
                    "ce:GetSavingsPlansUtilizationDetails"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "OrganizationsReadOnly",
                  "Effect": "Allow",
                  "Action": [
                    "organizations:ListAccounts"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "CostOptimizationHubReadOnly",
                  "Effect": "Allow",
                  "Action": [
                    "cost-optimization-hub:ListRecommendations",
                    "cost-optimization-hub:ListEnrollmentStatuses"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "CreditsReadOnly",
                  "Effect": "Allow",
                  "Action": [
                    "billing:GetCredits"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "CostfluentExportRead": {
      "Type": "AWS::IAM::RolePolicy",
      "Condition": "CreateExport",
      "Properties": {
        "RoleName": {
          "Ref": "CostfluentRole"
        },
        "PolicyName": "CostfluentExportRead",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ExportBucketList",
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${BucketName}"
              }
            },
            {
              "Sid": "ExportObjectRead",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${BucketName}/${ExportPrefix}/*"
              }
            }
          ]
        }
      }
    },
    "ExportBucket": {
      "Type": "AWS::S3::Bucket",
      "Condition": "CreateBucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Ref": "BucketName"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "ExportBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Condition": "CreateBucket",
      "Properties": {
        "Bucket": {
          "Ref": "ExportBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowDataExportsDelivery",
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "billingreports.amazonaws.com",
                  "bcm-data-exports.amazonaws.com"
                ]
              },
              "Action": [
                "s3:PutObject",
                "s3:GetBucketPolicy"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BucketName}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BucketName}/*"
                }
              ],
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "StringLike": {
                  "aws:SourceArn": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cur:us-east-1:${AWS::AccountId}:definition/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bcm-data-exports:us-east-1:${AWS::AccountId}:export/*"
                    }
                  ]
                }
              }
            },
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BucketName}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BucketName}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ExportBucketReady": {
      "Type": "AWS::CloudFormation::WaitConditionHandle",
      "Condition": "CreateExport",
      "Metadata": {
        "BucketPolicy": {
          "Fn::If": [
            "CreateBucket",
            {
              "Ref": "ExportBucketPolicy"
            },
            ""
          ]
        }
      }
    },
    "FocusExport": {
      "Type": "AWS::BCMDataExports::Export",
      "Condition": "CreateFocusExport",
      "DependsOn": "ExportBucketReady",
      "Properties": {
        "Export": {
          "Name": {
            "Ref": "ExportName"
          },
          "Description": "FOCUS 1.2 cost and usage for Costfluent.",
          "DataQuery": {
            "QueryStatement": "SELECT AvailabilityZone, BilledCost, BillingAccountId, BillingAccountName, BillingAccountType, BillingCurrency, BillingPeriodEnd, BillingPeriodStart, CapacityReservationId, CapacityReservationStatus, ChargeCategory, ChargeClass, ChargeDescription, ChargeFrequency, ChargePeriodEnd, ChargePeriodStart, CommitmentDiscountCategory, CommitmentDiscountId, CommitmentDiscountName, CommitmentDiscountQuantity, CommitmentDiscountStatus, CommitmentDiscountType, CommitmentDiscountUnit, ConsumedQuantity, ConsumedUnit, ContractedCost, ContractedUnitPrice, EffectiveCost, InvoiceId, InvoiceIssuerName, ListCost, ListUnitPrice, PricingCategory, PricingCurrency, PricingCurrencyContractedUnitPrice, PricingCurrencyEffectiveCost, PricingCurrencyListUnitPrice, PricingQuantity, PricingUnit, ProviderName, PublisherName, RegionId, RegionName, ResourceId, ResourceName, ResourceType, ServiceCategory, ServiceName, ServiceSubcategory, SkuId, SkuMeter, SkuPriceDetails, SkuPriceId, SubAccountId, SubAccountName, SubAccountType, Tags, x_Discounts, x_Operation, x_ServiceCode FROM FOCUS_1_2_AWS",
            "TableConfigurations": {
              "FOCUS_1_2_AWS": {
                "TIME_GRANULARITY": "DAILY"
              }
            }
          },
          "DestinationConfigurations": {
            "S3Destination": {
              "S3Bucket": {
                "Fn::If": [
                  "CreateBucket",
                  {
                    "Ref": "ExportBucket"
                  },
                  {
                    "Ref": "BucketName"
                  }
                ]
              },
              "S3Prefix": {
                "Ref": "ExportPrefix"
              },
              "S3Region": {
                "Ref": "BucketRegion"
              },
              "S3OutputConfigurations": {
                "Overwrite": "OVERWRITE_REPORT",
                "Format": "TEXT_OR_CSV",
                "Compression": "GZIP",
                "OutputType": "CUSTOM"
              }
            }
          },
          "RefreshCadence": {
            "Frequency": "SYNCHRONOUS"
          }
        }
      }
    },
    "CarbonExport": {
      "Type": "AWS::BCMDataExports::Export",
      "Condition": "CreateCarbon",
      "DependsOn": "ExportBucketReady",
      "Properties": {
        "Export": {
          "Name": "costfluent-carbon",
          "Description": "Carbon emissions for Costfluent.",
          "DataQuery": {
            "QueryStatement": "SELECT last_refresh_timestamp, usage_period_start, usage_period_end, location, model_version, payer_account_id, usage_account_id, product_code, region_code, total_lbm_emissions_value, total_lbm_emissions_unit, total_mbm_emissions_value, total_mbm_emissions_unit, total_scope_1_emissions_value, total_scope_1_emissions_unit, total_scope_2_lbm_emissions_value, total_scope_2_lbm_emissions_unit, total_scope_2_mbm_emissions_value, total_scope_2_mbm_emissions_unit, total_scope_3_lbm_emissions_value, total_scope_3_lbm_emissions_unit, total_scope_3_mbm_emissions_value, total_scope_3_mbm_emissions_unit FROM CARBON_EMISSIONS"
          },
          "DestinationConfigurations": {
            "S3Destination": {
              "S3Bucket": {
                "Fn::If": [
                  "CreateBucket",
                  {
                    "Ref": "ExportBucket"
                  },
                  {
                    "Ref": "BucketName"
                  }
                ]
              },
              "S3Prefix": {
                "Ref": "ExportPrefix"
              },
              "S3Region": {
                "Ref": "BucketRegion"
              },
              "S3OutputConfigurations": {
                "Overwrite": "OVERWRITE_REPORT",
                "Format": "PARQUET",
                "Compression": "PARQUET",
                "OutputType": "CUSTOM"
              }
            }
          },
          "RefreshCadence": {
            "Frequency": "SYNCHRONOUS"
          }
        }
      }
    },
    "CostfluentConnection": {
      "Type": "Custom::CostfluentConnection",
      "Properties": {
        "ServiceToken": {
          "Ref": "PingbackTopicArn"
        },
        "HandshakeId": {
          "Ref": "HandshakeId"
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "CostfluentRole",
            "Arn"
          ]
        },
        "BucketName": {
          "Fn::If": [
            "CreateExport",
            {
              "Ref": "BucketName"
            },
            ""
          ]
        },
        "BucketRegion": {
          "Fn::If": [
            "CreateExport",
            {
              "Ref": "BucketRegion"
            },
            ""
          ]
        },
        "ExportPrefix": {
          "Fn::If": [
            "CreateExport",
            {
              "Ref": "ExportPrefix"
            },
            ""
          ]
        },
        "ExportName": {
          "Fn::If": [
            "CreateExport",
            {
              "Ref": "ExportName"
            },
            ""
          ]
        },
        "ExportReadPolicy": {
          "Fn::If": [
            "CreateExport",
            {
              "Ref": "CostfluentExportRead"
            },
            ""
          ]
        },
        "ExportArn": {
          "Fn::If": [
            "CreateFocusExport",
            {
              "Ref": "FocusExport"
            },
            ""
          ]
        },
        "CarbonExportName": {
          "Fn::If": [
            "CreateCarbon",
            "costfluent-carbon",
            ""
          ]
        },
        "CarbonExportArn": {
          "Fn::If": [
            "CreateCarbon",
            {
              "Ref": "CarbonExport"
            },
            ""
          ]
        }
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "The role Costfluent assumes.",
      "Value": {
        "Fn::GetAtt": [
          "CostfluentRole",
          "Arn"
        ]
      }
    },
    "BucketName": {
      "Condition": "CreateExport",
      "Description": "Where the FOCUS 1.2 export is delivered.",
      "Value": {
        "Ref": "BucketName"
      }
    },
    "ExportName": {
      "Condition": "CreateExport",
      "Description": "The Data Export Costfluent reads.",
      "Value": {
        "Ref": "ExportName"
      }
    },
    "CarbonExportName": {
      "Condition": "CreateCarbon",
      "Description": "The carbon emissions Data Export Costfluent reads.",
      "Value": "costfluent-carbon"
    }
  }
}
